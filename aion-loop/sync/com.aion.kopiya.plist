<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aion.kopiya</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string><AION_ROOT>/bin/kopiya.py</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string><HOME>/Backups/nightly/kopiya.out.log</string>
  <key>StandardErrorPath</key><string><HOME>/Backups/nightly/kopiya.err.log</string>
</dict>
</plist>
